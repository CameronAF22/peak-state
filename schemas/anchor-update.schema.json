{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peak-state.local/schemas/anchor-update.schema.json",
  "title": "Anchor update",
  "description": "A single profile mutation emitted by the voice guide after the person confirms a cue. Clients apply these in order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "at"],
  "properties": {
    "op": {
      "enum": ["set-state", "set-anchor", "confirm-stack", "mark-entered"]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "peakState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "channel": {
      "enum": ["auditory", "visual", "kinesthetic"]
    },
    "anchor": {
      "type": "object",
      "description": "The channel object matching user-state-profile anchors.<channel>."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "set-state" } }, "required": ["op"] },
      "then": { "required": ["peakState"] }
    },
    {
      "if": { "properties": { "op": { "const": "set-anchor" } }, "required": ["op"] },
      "then": { "required": ["channel", "anchor"] }
    }
  ]
}
