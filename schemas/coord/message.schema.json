{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peak-state.local/schemas/coord/message.schema.json",
  "title": "Lane message",
  "description": "coord/messages/<id>.json. One file per message so parallel branches never conflict. `to` is a lane id, `all`, or `human`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "from", "to", "subject", "body", "refs", "replyTo", "createdAt", "session"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^M-[0-9]{8}T[0-9]{6}Z-[a-z][a-z0-9-]{1,23}-[0-9a-f]{4}$" },
    "from": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" },
    "to": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
    "body": { "type": "string" },
    "refs": { "type": "array", "items": { "type": "string" } },
    "replyTo": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "session": { "$ref": "#/$defs/sessionRef" }
  },
  "$defs": {
    "sessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "branch"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": ["string", "null"], "pattern": "^https://" },
        "branch": { "type": ["string", "null"] }
      }
    }
  }
}
