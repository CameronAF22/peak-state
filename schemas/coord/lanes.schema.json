{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peak-state.local/schemas/coord/lanes.schema.json",
  "title": "Lane registry",
  "description": "coord/lanes.json. Every repository path belongs to exactly one lane (longest matching prefix wins). Paths under `generated` are coordination records and generated output, written only by tools/coord.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "generated",
    "lanes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repo",
        "defaultBranch",
        "laneBranchPrefix",
        "dashboardBranch"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "laneBranchPrefix": {
          "type": "string",
          "minLength": 1
        },
        "dashboardBranch": {
          "type": "string",
          "minLength": 1
        },
        "dashboardUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifactUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "claude.ai Artifact snapshot of the dashboard, republished by coord at each gate."
        }
      }
    },
    "generated": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "/$"
      },
      "uniqueItems": true
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mission",
        "owns",
        "deliverables",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,23}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "owns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/]"
          },
          "description": "A path ending in / owns everything under it; anything else is one exact file."
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "humanOwner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
