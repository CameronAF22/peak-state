{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peak-state.local/schemas/coord/trace.schema.json",
  "title": "Lane trace",
  "description": "coord/trace/<lane>.json, generated by `coord.py build`. The exact bytes each lane-owned file had at build time and the decisions that cover it. CI fails when it is stale.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lane", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lane": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "decisions"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "decisions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
